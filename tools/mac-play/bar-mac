#!/usr/bin/env bash
# bar-mac: install and play Beyond All Reason on Apple Silicon with the
# macOS Recoil test builds from tomjn's integration branch (PR #3271).
#
# Nothing here is official. Online play on BAR's public servers with an
# unofficial build risks desyncing other people's games; use skirmish,
# replays, or private direct-IP games with players who know the risk.
#
# Content (game, lobby, maps) is always fetched from BAR's own CDN. This
# script never bundles or rehosts it.

set -euo pipefail

ENGINE_TAG="${BAR_MAC_ENGINE_TAG:-macos-2026.09.02-test1}"
ENGINE_VERSION="${BAR_MAC_ENGINE_VERSION:-2026.09.02}"
ENGINE_REPO="${BAR_MAC_ENGINE_REPO:-tomjn/RecoilEngine}"
SPRING_HOME="${BAR_MAC_HOME:-$HOME/.spring}"
GAME_TAG="byar:test"
LOBBY_TAG="byar-chobby:test"
DEFAULT_MAP="Red Comet Remake 1.8"
DEFAULT_PORT=8452

ENGINE_DIR="$SPRING_HOME/engine/macos_arm64/$ENGINE_VERSION"

export PRD_HTTP_SEARCH_URL="https://files-cdn.beyondallreason.dev/find"
export PRD_RAPID_USE_STREAMER="false"
export PRD_RAPID_REPO_MASTER="https://repos-cdn.beyondallreason.dev/repos.gz"

die() { echo "bar-mac: $*" >&2; exit 1; }
say() { echo "==> $*"; }

need_engine() {
	[[ -x "$ENGINE_DIR/spring" ]] || die "engine not installed; run: bar-mac install"
}

prd() { "$ENGINE_DIR/pr-downloader" --filesystem-writepath "$SPRING_HOME" "$@"; }

# The archive name the engine needs in a start script, e.g.
# "Beyond All Reason test-12345-abcdef0", read from the rapid index.
game_name() {
	local idx
	idx=$(ls "$SPRING_HOME"/rapid/*/byar/versions.gz 2>/dev/null | head -1)
	[[ -n "$idx" ]] || die "game not downloaded; run: bar-mac install"
	gzip -dc "$idx" | awk -F, -v t="$GAME_TAG" '$1==t {print $4; exit}'
}

installed_tag() { cat "$ENGINE_DIR/.bar-mac-tag" 2>/dev/null || echo "unknown"; }

set_setting() { # key value: add or replace a line in springsettings.cfg
	local cfg="$SPRING_HOME/springsettings.cfg" key="$1" val="$2"
	touch "$cfg"
	grep -v "^$key *=" "$cfg" > "$cfg.tmp" || true
	echo "$key = $val" >> "$cfg.tmp"
	mv "$cfg.tmp" "$cfg"
}

cmd_install() {
	[[ "$(uname -s)/$(uname -m)" == "Darwin/arm64" ]] || die "needs an Apple Silicon Mac"
	command -v 7zz >/dev/null || die "needs 7zz: brew install sevenzip"
	mkdir -p "$SPRING_HOME"

	# A test build is identified by its release tag, not its version: tomjn
	# ships several test builds of one engine version.
	if [[ -x "$ENGINE_DIR/spring" && "$(installed_tag)" == "$ENGINE_TAG" ]]; then
		say "engine $ENGINE_TAG already installed"
	else
		local tmp url
		tmp=$(mktemp -d)
		url="https://github.com/$ENGINE_REPO/releases/download/$ENGINE_TAG/recoil_${ENGINE_VERSION}_arm64-macos.7z"
		say "downloading engine $ENGINE_TAG (installed: $(installed_tag))"
		curl -fL --progress-bar -o "$tmp/engine.7z" "$url"
		mkdir -p "$ENGINE_DIR"
		7zz x -y "$tmp/engine.7z" -o"$ENGINE_DIR" > /dev/null
		rm -rf "$tmp"
		xattr -dr com.apple.quarantine "$ENGINE_DIR" 2>/dev/null || true
		echo "$ENGINE_TAG" > "$ENGINE_DIR/.bar-mac-tag"
	fi

	say "downloading $GAME_TAG and $LOBBY_TAG from BAR's CDN (first run is large)"
	prd --download-game "$GAME_TAG"
	prd --download-game "$LOBBY_TAG"
	prd --download-map "$DEFAULT_MAP"

	set_setting RapidTagResolutionOrder "repos-cdn.beyondallreason.dev;repos.beyondallreason.dev"
	cat > "$SPRING_HOME/chobby_config.json" <<-'JSON'
	{"server": {"address": "server4.beyondallreason.info", "port": 8200, "protocol": "spring", "serverName": "BAR"}, "game": "byar"}
	JSON
	say "installed: $(game_name) on engine $ENGINE_VERSION"
}

cmd_update() { # refresh game and lobby to the current test versions
	need_engine
	prd --download-game "$GAME_TAG"
	prd --download-game "$LOBBY_TAG"
	say "game is now $(game_name)"
}

cmd_play() { # the normal BAR lobby, for skirmish and replays
	need_engine
	exec "$ENGINE_DIR/spring" --write-dir "$SPRING_HOME" --menu "rapid://$LOBBY_TAG"
}

cmd_map() {
	need_engine
	[[ $# -ge 1 ]] || die "usage: bar-mac map \"Map Name 1.0\""
	prd --download-map "$1"
}

# Start script for a direct-IP game. Players are named p1..pN on teams
# 0..N-1, each its own ally team; every slot shares one password.
write_host_script() { # file map port players password [ai]
	local f="$1" map="$2" port="$3" n="$4" pw="$5" ai="${6:-}" game teams i
	game=$(game_name)
	teams=$n
	[[ -n "$ai" ]] && teams=$((n + 1))
	{
		echo "[GAME]"
		echo "{"
		echo "	MapName=$map;"
		echo "	GameType=$game;"
		echo "	HostIP=;"
		echo "	HostPort=$port;"
		echo "	IsHost=1;"
		echo "	NumPlayers=$n;"
		echo "	NumTeams=$teams;"
		echo "	NumAllyTeams=$teams;"
		echo "	StartPosType=1;"
		for ((i = 0; i < n; i++)); do
			echo "	[PLAYER$i] { Name=p$((i + 1)); Password=$pw; Spectator=0; Team=$i; }"
			echo "	[TEAM$i] { TeamLeader=$i; AllyTeam=$i; }"
			echo "	[ALLYTEAM$i] { NumAllies=0; }"
		done
		if [[ -n "$ai" ]]; then
			echo "	[AI0] { Name=bot; ShortName=$ai; Team=$n; Host=0; }"
			echo "	[TEAM$n] { TeamLeader=0; AllyTeam=$n; }"
			echo "	[ALLYTEAM$n] { NumAllies=0; }"
		fi
		echo "	[MODOPTIONS] { }"
		echo "}"
	} > "$f"
}

write_join_script() { # file host port name password
	cat > "$1" <<-EOF
	[GAME]
	{
		HostIP=$2;
		HostPort=$3;
		IsHost=0;
		MyPlayerName=$4;
		MyPasswd=$5;
	}
	EOF
}

parse_opts() { # sets MAP PORT PLAYERS PASSWORD NAME AI ADDRESS NOSTART
	MAP="$DEFAULT_MAP"; PORT=$DEFAULT_PORT; PLAYERS=2; PASSWORD=""; NAME=""; AI=""; ADDRESS=""; NOSTART=0
	while [[ $# -gt 0 ]]; do
		case "$1" in
			--map) MAP="$2"; shift 2 ;;
			--port) PORT="$2"; shift 2 ;;
			--players) PLAYERS="$2"; shift 2 ;;
			--password) PASSWORD="$2"; shift 2 ;;
			--name) NAME="$2"; shift 2 ;;
			--ai) AI="$2"; shift 2 ;;
			--address) ADDRESS="$2"; shift 2 ;;
			--no-start) NOSTART=1; shift ;;
			*) ARGS+=("$1"); shift ;;
		esac
	done
}

# One join file per player, with Windows line endings so Notepad shows it
# correctly, plus a short how-to. Hand each player their file.
write_player_kit() { # dir address port players password
	local dir="$1" addr="$2" port="$3" n="$4" pw="$5" i f
	mkdir -p "$dir/players"
	for ((i = 1; i <= n; i++)); do
		f="$dir/players/join-p$i.txt"
		write_join_script "$f" "$addr" "$port" "p$i" "$pw"
		sed -i '' 's/$/\r/' "$f"
	done
	cat > "$dir/players/HOW-TO-JOIN.txt" <<-EOF
	Beyond All Reason private game: $(game_name), engine $ENGINE_VERSION, map $MAP

	Windows
	  1. Open the Beyond All Reason launcher, pick "Engine Test" in the
	     dropdown, and let it finish updating. Close the lobby that opens.
	  2. Save your file (join-pN.txt) into the launcher's data folder:
	       <BAR install folder>\\data
	     The default install folder is usually
	       %LOCALAPPDATA%\\Programs\\Beyond-All-Reason
	  3. Open Command Prompt in that data folder and run:
	       engine\\recoil_${ENGINE_VERSION}\\spring.exe --write-dir "%CD%" join-pN.txt
	     If Windows Firewall asks, allow spring.exe.

	Mac (bar-mac)
	  bar-mac join $addr --name pN --password $pw --port $port

	Everyone needs the same game version. If you see a version or checksum
	error, everyone updates the launcher ("Engine Test") or runs
	bar-mac update, and the host restarts.
	EOF
	sed -i '' 's/$/\r/' "$dir/players/HOW-TO-JOIN.txt"
}

cmd_host() { # dedicated server only; players connect with `bar-mac join` or a join file
	need_engine
	ARGS=(); parse_opts "$@"
	[[ -n "$PASSWORD" ]] || PASSWORD=$(LC_ALL=C tr -dc 'a-z0-9' < /dev/urandom | head -c 8)
	[[ -n "$ADDRESS" ]] || ADDRESS="HOST_ADDRESS"
	local dir="$SPRING_HOME/direct"; mkdir -p "$dir"
	write_host_script "$dir/host.txt" "$MAP" "$PORT" "$PLAYERS" "$PASSWORD" "$AI"
	write_player_kit "$dir" "$ADDRESS" "$PORT" "$PLAYERS" "$PASSWORD"
	say "hosting $(game_name) on $MAP, UDP port $PORT, $PLAYERS players"
	say "player files: $dir/players (join-p1.txt .. join-p$PLAYERS.txt, HOW-TO-JOIN.txt)"
	[[ "$ADDRESS" == HOST_ADDRESS ]] && say "no --address given: players replace HOST_ADDRESS in their file with the address they reach this host at"
	say "Mac players: bar-mac join $ADDRESS --name pN --password $PASSWORD"
	[[ $NOSTART -eq 1 ]] && { say "--no-start: files written, server not started"; return 0; }
	cd "$dir"
	SPRING_WRITEDIR="$dir/host-home" SPRING_DATADIR="$SPRING_HOME" \
		exec "$ENGINE_DIR/spring-dedicated" "$dir/host.txt"
}

cmd_join() {
	need_engine
	ARGS=(); parse_opts "$@"
	[[ ${#ARGS[@]} -ge 1 ]] || die "usage: bar-mac join HOST_IP --name pN --password PW [--port $DEFAULT_PORT]"
	[[ -n "$NAME" && -n "$PASSWORD" ]] || die "join needs --name and --password from the host"
	local dir="$SPRING_HOME/direct"; mkdir -p "$dir"
	write_join_script "$dir/join.txt" "${ARGS[0]}" "$PORT" "$NAME" "$PASSWORD"
	exec "$ENGINE_DIR/spring" --write-dir "$SPRING_HOME" "$dir/join.txt"
}

# Compare what is installed here with what Windows and Linux players get
# from BAR's launcher today. Exits 1 when a game with them would not match.
cmd_check() {
	local rc=0 win_engine remote_game local_game latest_tag
	win_engine=$(curl -fsL "https://raw.githubusercontent.com/beyond-all-reason/BYAR-Chobby/master/dist_cfg/config.json" |
		python3 -c 'import json,sys
d=json.load(sys.stdin)
print(next((s["launch"]["engine"] for s in d["setups"] if s["package"]["display"]=="Engine Test" and s["package"]["platform"]=="win32"),"?"))' 2>/dev/null || echo "?")
	remote_game=$(curl -fsL "https://repos-cdn.beyondallreason.dev/byar/versions.gz" | gzip -dc 2>/dev/null |
		awk -F, -v t="$GAME_TAG" '$1==t {print $4; exit}')
	local_game=$(game_name 2>/dev/null || echo "not installed")
	latest_tag=$(curl -fsL "https://api.github.com/repos/$ENGINE_REPO/releases?per_page=20" |
		python3 -c 'import json,sys
r=[x["tag_name"] for x in json.load(sys.stdin) if x["tag_name"].startswith("macos-")]
print(r[0] if r else "?")' 2>/dev/null || echo "?")

	echo "engine here:        $ENGINE_VERSION ($(installed_tag))"
	echo "Windows Engine Test: ${win_engine#recoil_}"
	echo "newest macOS build: $latest_tag ($ENGINE_REPO)"
	echo "game here:          $local_game"
	echo "game on BAR's CDN:  ${remote_game:-?}"

	if [[ "${win_engine#recoil_}" != "$ENGINE_VERSION" ]]; then
		say "MISMATCH: Windows players now get engine ${win_engine#recoil_}; this Mac runs $ENGINE_VERSION."
		[[ "$latest_tag" == "macos-${win_engine#recoil_}-"* ]] &&
			say "fix: BAR_MAC_ENGINE_TAG=$latest_tag BAR_MAC_ENGINE_VERSION=${win_engine#recoil_} bar-mac install" ||
			say "no macOS build of ${win_engine#recoil_} yet; cross-play waits for one"
		rc=1
	fi
	if [[ -n "$remote_game" && "$remote_game" != "$local_game" ]]; then
		say "UPDATE: the test game moved on; run bar-mac update (and everyone updates their launcher)"
		rc=1
	fi
	if [[ "$latest_tag" != "$(installed_tag)" && "$latest_tag" == "macos-$ENGINE_VERSION-"* ]]; then
		say "NEWER BUILD: $latest_tag; run BAR_MAC_ENGINE_TAG=$latest_tag bar-mac install"
		rc=1
	fi
	[[ $rc -eq 0 ]] && say "OK: matches what Windows players get today"
	return $rc
}

# Local network self-test: a dedicated host and two headless players on
# 127.0.0.1. Proves host, connect and game start without another machine.
cmd_selftest() {
	need_engine
	ARGS=(); parse_opts "$@"
	local secs="${ARGS[0]:-60}" dir pw=selftest port=$((DEFAULT_PORT + 100)) rc=0
	dir=$(mktemp -d "${TMPDIR:-/tmp}/bar-mac-selftest.XXXX")
	write_host_script "$dir/host.txt" "$MAP" "$port" 2 "$pw" "${AI:-}"
	write_join_script "$dir/p1.txt" 127.0.0.1 "$port" p1 "$pw"
	write_join_script "$dir/p2.txt" 127.0.0.1 "$port" p2 "$pw"
	mkdir -p "$dir/host" "$dir/p1" "$dir/p2"
	local who
	for who in host p1 p2; do # flush every line, so a killed run still has its log
		echo "LogFlushLevel = 0" > "$dir/$who/springsettings.cfg"
	done

	say "selftest in $dir for ${secs}s"
	(cd "$dir/host" && SPRING_WRITEDIR="$dir/host" SPRING_DATADIR="$SPRING_HOME" \
		exec "$ENGINE_DIR/spring-dedicated" "$dir/host.txt" > "$dir/host/stdout.log" 2>&1) &
	local hpid=$!
	sleep 3
	(cd "$dir/p1" && SPRING_WRITEDIR="$dir/p1" SPRING_DATADIR="$SPRING_HOME" \
		exec "$ENGINE_DIR/spring-headless" "$dir/p1.txt" > "$dir/p1/stdout.log" 2>&1) &
	local p1=$!
	(cd "$dir/p2" && SPRING_WRITEDIR="$dir/p2" SPRING_DATADIR="$SPRING_HOME" \
		exec "$ENGINE_DIR/spring-headless" "$dir/p2.txt" > "$dir/p2/stdout.log" 2>&1) &
	local p2=$!

	sleep "$secs"
	kill "$p1" "$p2" "$hpid" 2>/dev/null || true
	wait 2>/dev/null || true

	local joined frame
	joined=$(grep -c "Connection established" "$dir/host/infolog.txt" 2>/dev/null || true)
	say "host accepted $joined of 2 players"
	[[ "$joined" -ge 2 ]] || rc=1
	for who in p1 p2; do
		frame=$(grep -oE "\[f=[0-9]+\]" "$dir/$who/infolog.txt" 2>/dev/null | tail -1 | tr -dc 0-9)
		say "$who last simulated frame: ${frame:-none (game never started)}"
		[[ -n "$frame" ]] || rc=1
	done
	if grep -qiE "sync ?error|desync" "$dir"/*/infolog.txt 2>/dev/null; then
		say "sync errors logged:"; grep -iE "sync ?error|desync" "$dir"/*/infolog.txt | head -5; rc=1
	fi
	[[ $rc -eq 0 ]] && say "PASS" || say "FAIL"
	say "logs kept in $dir"
	return $rc
}

usage() {
	cat <<-EOF
	bar-mac: Beyond All Reason on Apple Silicon (unofficial, test engine $ENGINE_VERSION)

	  bar-mac install            engine + BAR test game + lobby + one map
	  bar-mac update             refresh game and lobby
	  bar-mac play               open the BAR lobby (skirmish, replays)
	  bar-mac map "Name 1.0"     download a map from BAR's CDN
	  bar-mac check              compare with what Windows players get today
	  bar-mac host [--map M] [--players N] [--password P] [--port $DEFAULT_PORT]
	               [--address A] [--ai BARb] [--no-start]
	                             also writes join files for every player
	  bar-mac join HOST_IP --name pN --password P [--port $DEFAULT_PORT]
	  bar-mac selftest [SECONDS]  local host + two headless players

	Data lives in \$BAR_MAC_HOME (default ~/.spring).
	EOF
}

case "${1:-}" in
	install|update|play|map|check|host|join|selftest) c="$1"; shift; "cmd_$c" "$@" ;;
	*) usage ;;
esac
